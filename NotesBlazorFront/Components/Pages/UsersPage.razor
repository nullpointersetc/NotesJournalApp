<!-- UsersPage.razor -->
@page "/users"

@inject NullPointersEtc.NotesJournalApp.NotesBlazorFront.States.UsersState UsersState

<h1 class="mb-3">Users</h1>

<div class="row">
    <div class="col-4">
        <UserList Users="UsersState.Users" SelectedUser="UsersState.SelectedUser" OnSelect="HandleSelect" />
    </div>

    <div class="col-8">
        <UserEditor User="UsersState.SelectedUser" OnSave="HandleSave" />
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        UsersState.OnChange += StateChanged;
        await UsersState.LoadAsync();
    }

    private void StateChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleSelect(Guid id)
    {
        await UsersState.SelectAsync(id);
    }

    private async Task HandleSave(
        /* System.Tuple<System.Guid, string, string, string> data */)
    {
        /*
        if (data.Item1 == System.Guid.Empty)
            await UsersState.CreateAsync(
                identifier: data.Item2,
                display: data.Item3, eMail: data.Item4);
        else
            await UsersState.UpdateAsync(userID: data.Item1,
                display: data.Item3, eMail: data.Item4);
                */
    }

    public void Dispose()
    {
        UsersState.OnChange -= StateChanged;
    }
}
<!-- end "UsersPage.razor" -->
